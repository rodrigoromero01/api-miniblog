# PORT
PORT=3000

# POSTGRES
# formato: postgresql://usuario:password@host:puerto/nombre_db
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/miniblog

# base de datos solo para los tests (se borra en cada test, NO usar la misma que DATABASE_URL)
TEST_DATABASE_URL=postgresql://postgres:your_password@localhost:5432/miniblog_test

# (opcional) External Database URL de la base en Render, solo para correr setup.sql/seed.sql desde la PC
RENDER_DATABASE_URL=
